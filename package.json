{
  "name": "koinonia-ai-church",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "start": "concurrently -k -n api,web \"node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts\" \"vite preview\"",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
