# Copy to .env.local and add ONE key to turn on live AI (translation, triage, meaning-drift check).
# Without a key Koinonia runs in clearly labelled sample mode.

# Option 1 (preferred when set): 0G Compute Router — https://pc.0g.ai → Dashboard → API Keys
ZEROG_API_KEY=
# ZEROG_MODEL=claude-opus-5.5
# ZEROG_BASE_URL=https://router-api.0g.ai

# Option 2: Anthropic API directly
ANTHROPIC_API_KEY=

# Required to open the pastor dashboard (attendees never sign in)
STAFF_PASSCODE=

# One-click demo sign-in on the staff page (true/false). Turn off for a real church.
DEMO_LOGIN=false

# Optional: native read-aloud voices via ElevenLabs (key, or a path to a .env file that has it)
ELEVENLABS_API_KEY=
# ELEVENLABS_ENV_FILE=/path/to/.env
